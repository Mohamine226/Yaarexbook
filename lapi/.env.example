# Copier en .env (facultatif : tout a une valeur par défaut pour le développement local)

# Dossier des données (base SQLite, fichiers téléversés, clé secrète). Défaut : ./data
# DATA_DIR=./data

# Clé de signature des jetons. Si absente, elle est générée au premier lancement
# et gardée dans DATA_DIR/secret_key.
# SECRET_KEY=

# Premier administrateur, créé au démarrage s'il n'existe pas encore
ADMIN_EMAIL=admin@yaarexbook.local
ADMIN_PASSWORD=ChangezMoi123

# Durée de validité d'une connexion (jours)
# TOKEN_DAYS=30

# Envoi des codes de réinitialisation par email (facultatif).
# Sans SMTP_HOST, le code est simplement affiché dans la console du serveur.
# SMTP_HOST=smtp.exemple.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Yaarexbook <no-reply@exemple.com>
